{
  "name": "cubit-ui-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Cubit Minimal Design System & Multi-framework UI Component Library",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "build:tokens": "pnpm --filter \"@cubit-ui/tokens\" run build",
    "build:core": "pnpm --filter \"@cubit-ui/core\" run build",
    "build:react": "pnpm --filter \"@cubit-ui/react\" run build",
    "build:svelte": "pnpm --filter \"@cubit-ui/svelte\" run build",
    "typecheck": "pnpm --filter \"./packages/*\" run typecheck",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,svelte,css,json}\"",
    "release:check": "pnpm run lint && pnpm run build && pnpm run typecheck && pnpm -r publish --dry-run --no-git-checks --access public",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuel-dev/Cubit.git"
  },
  "homepage": "https://github.com/tsuel-dev/Cubit#readme",
  "bugs": {
    "url": "https://github.com/tsuel-dev/Cubit/issues"
  }
}
