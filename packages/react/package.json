{
  "name": "@cubit-ui/react",
  "version": "3.0.0",
  "description": "React framework wrapper for Cubit UI Web Components",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuel-dev/Cubit.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/tsuel-dev/Cubit#readme",
  "bugs": {
    "url": "https://github.com/tsuel-dev/Cubit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "web-components",
    "ui",
    "design-system",
    "cubit"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@cubit-ui/core": "workspace:*",
    "@cubit-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
