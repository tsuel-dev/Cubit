{
  "name": "@cubit-ui/core",
  "version": "3.0.0",
  "description": "Core Web Components for Cubit UI Design System",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuel-dev/Cubit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/tsuel-dev/Cubit#readme",
  "bugs": {
    "url": "https://github.com/tsuel-dev/Cubit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "web-components",
    "ui",
    "design-system",
    "cubit"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cubit-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
